NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# AI donor matching via Google Gemini's free tier (server-side only — never
# prefix with NEXT_PUBLIC_). Without it, donors are ranked by the tag-based
# fallback. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the model (default gemini-3.8-flash)
# GEMINI_MODEL=gemini-2.5-flash

# WhatsApp outreach via the Twilio sandbox (server-side only).
# Without these, the Notify button is disabled and a setup banner is shown.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
