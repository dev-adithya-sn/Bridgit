NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# AI donor matching (server-side only — never prefix with NEXT_PUBLIC_).
# Without it, donors are ranked by the tag-based fallback.
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp outreach via the Twilio sandbox (server-side only).
# Without these, the Notify button is disabled and a setup banner is shown.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
